@startuml
component "API Gateway & Security Layer" as CMPAPIGATEWAY
component "Blog & Comments Service" as CMPBLOGSERVICE
component "Community & Q&A Service" as CMPCOMMUNITYSERVICE
component "Dataset Management Service" as CMPDATASETSERVICE
component "Fault Monitor & Auto-Recovery System" as CMPFAULTMONITORSERVICE
component "Single Page Web Application" as CMPFRONTEND
component "Online Model Execution Service" as CMPINFERENCESERVICE
component "Model Catalog & Review Service" as CMPMODELCATALOGSERVICE
component "Distributed Object Storage" as CMPOBJECTSTORAGE
component "Order & Payment Service" as CMPORDERPAYMENTSERVICE
component "Real-time Synchronization Service" as CMPREALTIMESYNCSERVICE
component "Recommendation Engine" as CMPRECOMMENDERSERVICE
component "Relational Data Store" as CMPRELATIONALDATASTORE
component "User & Social Management Service" as CMPUSERSERVICE
CMPAPIGATEWAY --> CMPBLOGSERVICE : gRPC
CMPAPIGATEWAY --> CMPCOMMUNITYSERVICE : gRPC
CMPAPIGATEWAY --> CMPDATASETSERVICE : gRPC
CMPAPIGATEWAY --> CMPINFERENCESERVICE : gRPC
CMPAPIGATEWAY --> CMPMODELCATALOGSERVICE : gRPC
CMPAPIGATEWAY --> CMPORDERPAYMENTSERVICE : gRPC
CMPAPIGATEWAY --> CMPRECOMMENDERSERVICE : gRPC
CMPAPIGATEWAY --> CMPUSERSERVICE : gRPC
CMPBLOGSERVICE --> CMPREALTIMESYNCSERVICE : event-publish
CMPBLOGSERVICE --> CMPRELATIONALDATASTORE : repository
CMPCOMMUNITYSERVICE --> CMPREALTIMESYNCSERVICE : event-publish
CMPCOMMUNITYSERVICE --> CMPRELATIONALDATASTORE : repository
CMPDATASETSERVICE --> CMPOBJECTSTORAGE : storage-access
CMPDATASETSERVICE --> CMPRELATIONALDATASTORE : repository
CMPFAULTMONITORSERVICE --> CMPAPIGATEWAY : health-check
CMPFAULTMONITORSERVICE --> CMPINFERENCESERVICE : health-check
CMPFRONTEND --> CMPAPIGATEWAY : REST/HTTPS
CMPFRONTEND --> CMPREALTIMESYNCSERVICE : WebSocket
CMPINFERENCESERVICE --> CMPDATASETSERVICE : synchronous-call
CMPINFERENCESERVICE --> CMPMODELCATALOGSERVICE : synchronous-call
CMPINFERENCESERVICE --> CMPOBJECTSTORAGE : storage-access
CMPMODELCATALOGSERVICE --> CMPOBJECTSTORAGE : storage-access
CMPMODELCATALOGSERVICE --> CMPRELATIONALDATASTORE : repository
CMPORDERPAYMENTSERVICE --> CMPRELATIONALDATASTORE : repository
CMPUSERSERVICE --> CMPRELATIONALDATASTORE : repository
@enduml
