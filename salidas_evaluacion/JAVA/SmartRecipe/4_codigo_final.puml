@startuml
component "Food Image Recognition Service" as CMPAIRECOGNITIONSERVICE
component "API Gateway & Security Filter" as CMPAPIGATEWAY
component "User and Authentication Service" as CMPAUTHSERVICE
component "Distributed Cache Manager" as CMPCACHEMANAGER
component "Community and Merchant Service" as CMPCOMMUNITYMERCHANTSERVICE
component "Mobile Client Application" as CMPMOBILEAPP
component "Nutrition and Diet Management Service" as CMPNUTRITIONDIETSERVICE
component "Secure Media Storage" as CMPOBJECTSTORAGE
component "Relational/Persistent Database" as CMPPRIMARYDATABASE
component "Recipe Management & Search Service" as CMPRECIPESERVICE
component "Personalized Recommendation Service" as CMPRECOMMENDATIONSERVICE
CMPAPIGATEWAY --> CMPAUTHSERVICE : rpc/http
