{
  "requirements": [
    {
      "id": "modelevolution-R001",
      "description": "Provide a browser-accessed web platform with collaborating front-end, back-end, and algorithm-support modules, using Neo4j and MySQL for model, evolution-relationship, and user data."
    },
    {
      "id": "modelevolution-R002",
      "description": "The system shall manage account lifecycle and role state for learners, contributors, and administrators, including registration, login, logout, password modification, and permission-change application submission."
    },
    {
      "id": "modelevolution-R003",
      "description": "User login shall use two-factor authentication and OAuth 2.0 or a similar security protocol."
    },
    {
      "id": "modelevolution-R004",
      "description": "The system shall enforce login-gated and role-based authorization for model and evolution-data modification, including rejection of unauthorized deletions, modification attempts, forged login data, and tampering."
    },
    {
      "id": "modelevolution-R005",
      "description": "The system shall support model search and viewing, including textual display of model basic attributes and performance metrics, and topology-based visualization of model evolution relationships and detailed structural changes."
    },
    {
      "id": "modelevolution-R006",
      "description": "Contributors shall be able to upload ONNX files, upload and edit PyTorch source code online, and modify model profiles."
    },
    {
      "id": "modelevolution-R007",
      "description": "The system shall support adding, deleting, and modifying model evolution relationships and internal layer-reuse relationships, while recording associated datasets, trained-model information, and structural-change details for later visualization."
    },
    {
      "id": "modelevolution-R008",
      "description": "Administrators shall be able to manage users, delete users, and review and adjust user permission changes."
    },
    {
      "id": "modelevolution-R009",
      "description": "The back end shall persist machine-learning model artifacts, model basic attributes, and model performance metrics as retrievable domain data."
    },
    {
      "id": "modelevolution-R013",
      "description": "The system shall protect sensitive data in transit and at rest and encrypt stored models."
    }
  ],
  "components": [
    {
      "id": "comp-web-frontend",
      "name": "Web Front-End Module",
      "type": "UserInterface",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R005",
        "modelevolution-R006"
      ]
    },
    {
      "id": "comp-api-gateway",
      "name": "API Gateway & Security Enforcer",
      "type": "Gateway",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R003",
        "modelevolution-R004",
        "modelevolution-R013"
      ]
    },
    {
      "id": "comp-auth-user-service",
      "name": "User & Identity Management Service",
      "type": "Service",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R002",
        "modelevolution-R003",
        "modelevolution-R004",
        "modelevolution-R008"
      ]
    },
    {
      "id": "comp-model-service",
      "name": "Model Management Service",
      "type": "Service",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R004",
        "modelevolution-R005",
        "modelevolution-R006",
        "modelevolution-R009",
        "modelevolution-R013"
      ]
    },
    {
      "id": "comp-evolution-service",
      "name": "Evolution & Topology Graph Service",
      "type": "Service",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R004",
        "modelevolution-R005",
        "modelevolution-R007"
      ]
    },
    {
      "id": "comp-algorithm-support",
      "name": "Algorithm Support & Model Processing Module",
      "type": "ProcessingUnit",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R006"
      ]
    },
    {
      "id": "comp-mysql-db",
      "name": "MySQL Database",
      "type": "Database",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R002",
        "modelevolution-R008",
        "modelevolution-R009",
        "modelevolution-R013"
      ]
    },
    {
      "id": "comp-neo4j-db",
      "name": "Neo4j Graph Database",
      "type": "Database",
      "tracesTo": [
        "modelevolution-R001",
        "modelevolution-R005",
        "modelevolution-R007"
      ]
    },
    {
      "id": "comp-encrypted-storage",
      "name": "Encrypted Model Artifact Storage",
      "type": "Storage",
      "tracesTo": [
        "modelevolution-R009",
        "modelevolution-R013"
      ]
    }
  ],
  "connectors": [
    {
      "id": "conn-fe-gateway",
      "name": "HTTPS/TLS",
      "source": "comp-web-frontend",
      "target": "comp-api-gateway"
    },
    {
      "id": "conn-gateway-auth",
      "name": "Internal gRPC/REST",
      "source": "comp-api-gateway",
      "target": "comp-auth-user-service"
    },
    {
      "id": "conn-gateway-model",
      "name": "Internal gRPC/REST",
      "source": "comp-api-gateway",
      "target": "comp-model-service"
    },
    {
      "id": "conn-gateway-evolution",
      "name": "Internal gRPC/REST",
      "source": "comp-api-gateway",
      "target": "comp-evolution-service"
    },
    {
      "id": "conn-auth-mysql",
      "name": "SQL Driver (Encrypted)",
      "source": "comp-auth-user-service",
      "target": "comp-mysql-db"
    },
    {
      "id": "conn-model-mysql",
      "name": "SQL Driver (Encrypted)",
      "source": "comp-model-service",
      "target": "comp-mysql-db"
    },
    {
      "id": "conn-model-storage",
      "name": "Secure Blob Storage API",
      "source": "comp-model-service",
      "target": "comp-encrypted-storage"
    },
    {
      "id": "conn-model-algo",
      "name": "Internal RPC",
      "source": "comp-model-service",
      "target": "comp-algorithm-support"
    },
    {
      "id": "conn-evolution-neo4j",
      "name": "Bolt Protocol (Encrypted)",
      "source": "comp-evolution-service",
      "target": "comp-neo4j-db"
    },
    {
      "id": "conn-evolution-model",
      "name": "Internal RPC",
      "source": "comp-evolution-service",
      "target": "comp-model-service"
    }
  ]
}