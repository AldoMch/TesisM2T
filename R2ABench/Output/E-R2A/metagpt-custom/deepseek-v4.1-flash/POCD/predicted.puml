@startuml

package "User Interface Layer" {
  component "Registration/Login UI" as UI_Login
  component "File Management UI" as UI_File
  component "Detection Configuration UI" as UI_Config
  component "Detection Record/Report UI" as UI_Report
  component "Detection Result UI" as UI_Result
  component "Help/Case UI" as UI_Help
}

package "Business Logic Layer" {
  component "Account & Authentication Service" as BL_Account
  component "File Management Service" as BL_File
  component "Detection Configuration Service" as BL_Config
  component "Detection Exception Configuration Service" as BL_ExceptionConfig
  component "MDJ Parser" as BL_MDJParser
  component "Database Parsing Service" as BL_DBParser
  component "Matching Orchestration Service" as BL_Matching
  component "Entity Matching Service" as BL_EntityMatch
  component "Relationship Matching Service" as BL_RelationshipMatch
  component "Attribute Matching Service" as BL_AttributeMatch
  component "Consistency Detection Service" as BL_Detection
  component "Repair Suggestion & Execution Service" as BL_Repair
  component "Report Export Service" as BL_Report
  component "Historical Record Service" as BL_History
  component "Help & Case Service" as BL_Help
  component "Open API Service" as BL_OpenAPI
  component "Asynchronous Processing Service" as BL_Async
  component "Access Control/Security Service" as BL_Access
  component "Logging/Audit Service" as BL_Logging
  component "Jackson/JSON Conversion" as BL_JSON
}

package "Data Access Layer" {
  component "User Data Access" as DA_User
  component "File Data Access" as DA_File
  component "Parsing Model Data Access" as DA_Parsing
  component "Configuration Data Access" as DA_Config
  component "Matching/Detection Data Access" as DA_Matching
  component "Repair/History Data Access" as DA_RepairHistory
  component "Modification Record Data Access" as DA_ModRecord
  component "Help/Case Data Access" as DA_Help
  component "Operation Log Data Access" as DA_Log
  component "JDBC Database Connector" as DA_JDBC
}

package "External Systems" {
  database "MySQL Database" as MySQL
  node "StarUML / MDJ class diagram files" as StarUML
  cloud "Third-party applications" as ThirdParty
}

package "Security & Cross-Cutting" {
  component "SSL/TLS Secure Transmission" as SEC_TLS
}

package "Test & Quality Assurance" {
  component "Automated Test Framework" as QA_Test
}

UI_Login --> BL_Account
