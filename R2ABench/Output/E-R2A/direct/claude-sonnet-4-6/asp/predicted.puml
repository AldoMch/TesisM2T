@startuml
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam rectangleBorderColor #555555
skinparam rectangleBackgroundColor #FFFFFF
skinparam nodeBorderColor #555555
skinparam nodeBackgroundColor #F0F0F0
skinparam databaseBorderColor #555555
skinparam databaseBackgroundColor #FFF8E1
skinparam cloudBorderColor #555555
skinparam cloudBackgroundColor #E8F5E9
skinparam componentBorderColor #555555
skinparam componentBackgroundColor #E3F2FD
skinparam arrowColor #333333
skinparam packageBorderColor #888888
skinparam packageBackgroundColor #FAFAFA
skinparam legendBackgroundColor #FFFFFF
skinparam legendBorderColor #AAAAAA
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFFF0

title Zhiyan Tongjie (智研通界) Academic Achievement Sharing Platform\nSystem Architecture Diagram

'==============================================================
' EXTERNAL ACTORS
'==============================================================
package "External Actors" <<Cloud>> {
  actor Visitor as VIS
  actor "Registered User" as REG
  actor "Certified Scholar" as SCH
  actor "Institution Administrator" as IADM
  actor "Expert Reviewer" as EXP
  actor "System Administrator" as SADM
}

package "External Data Sources" <<Cloud>> {
  node "Academic Database APIs" as EXTAPI
  node "Web Crawlers / Scrapers" as EXTCRAWL
}

'==============================================================
' CLIENT TIER
'==============================================================
package "Client Tier" {
  rectangle "Web Browser\n(Chrome / Edge / Firefox)\nWindows, Linux, macOS" as BROWSER {
    component "Vue 3.3 SPA Frontend" as VUE {
      component "Account & Portal UI\n(FR-001..005)" as UI_ACCT
      component "Literature Discovery UI\n(FR-006..011)" as UI_LIT
      component "Achievement Management UI\n(FR-012..014)" as UI_ACH
      component "Institution Management UI\n(FR-015..016)" as UI_INST
      component "Academic Interaction UI\n(FR-017..021)" as UI_COMM
      component "Analysis & Reports UI\n(FR-025,FR-027)" as UI_ANAL
      component "Administration UI\n(FR-003,FR-012,FR-014..016,FR-028)" as UI_ADMIN
    }
  }
}

'==============================================================
' APPLICATION LAYER  (Django 4.2 LTS / Python)
'==============================================================
package "Application Layer  [Django 4.2 LTS / Python]" {

  package "Business Domain Services" {
    rectangle "Account & Scholar Portal Service\n(FR-001,FR-002,FR-003,FR-004,FR-005)" as SVC_ACCT
    rectangle "Literature Retrieval & Recommendation Service\n(FR-006,FR-007,FR-008,FR-009,FR-010,FR-011)" as SVC_LIT
    rectangle "Achievement & Classification Service\n(FR-012,FR-013,FR-014)" as SVC_ACH
    rectangle "Institution Management Service\n(FR-015,FR-016)" as SVC_INST
    rectangle "Academic Interaction & Collaboration Service\n(FR-017,FR-018,FR-019,FR-020,FR-021)" as SVC_COMM
    rectangle "Data Acquisition & Synchronization Service\n(FR-022,FR-023,FR-024)" as SVC_SYNC
    rectangle "Academic Analysis Service\n(FR-025)" as SVC_ANAL
    rectangle "Data Protection & Integrity Service\n(FR-026,FR-027,FR-028)" as SVC_PROT
    rectangle "Administration Service\n(FR-003,FR-012,FR-014..016,FR-028)" as SVC_ADMIN
  }
}

'==============================================================
' SUPPORT LAYER  (Shared Cross-Cutting Services)
'==============================================================
package "Support Layer  [Shared Platform Services]" {

  rectangle "Semantic Processing Service\nError correction, cross-language mapping,\nChinese/English/Japanese/German\n(FR-007,FR-008,NFR-009)" as SUP_SEM

  rectangle "User Profiling & Personalization Service\nPresentation preferences, behavior tracking,\ndiversity rules\n(FR-010,FR-011,DR-007)" as SUP_PROF

  rectangle "Authorization & Access Control Service\nRole enforcement, institution scope,\nresource permissions, disclosure state\n(NFR-005,FR-026,FR-027,C-006)" as SUP_AUTH

  rectangle "Academic Analysis Engine\nHotspot reports, scholar influence profiles,\nperiod tracking\n(FR-025,DR-009)" as SUP_ANALENG

  rectangle "Misconduct Detection Service\nPlagiarism checking, blacklist filtering\n(FR-028,DR-009)" as SUP_MISCON

  rectangle "Notification & Messaging Service\nEncrypted private messaging, verified\nparticipants, status notifications\n(FR-019,NFR-004)" as SUP_MSG

  rectangle "Search Context Manager\nMulti-turn conversational context,\nsession-scoped state\n(FR-008,DR-007)" as SUP_SRCHCTX

  rectangle "Scheduler & Job Manager\nDaily incremental sync, hourly/daily backup,\nanalysis runs\n(FR-024,FR-025,NFR-006)" as SUP_SCHED

  rectangle "Backup & Recovery Service\nFull daily + hourly incremental,\n30-day retention, restore chain\n(NFR-006,DR-011)" as SUP_BKP
}

'==============================================================
' INFRASTRUCTURE LAYER
'==============================================================
package "Infrastructure Layer" {

  package "Persistence" {
    database "MySQL 8.0 Cluster\n(Structured Data)\n\nUser accounts & auth (DR-001)\nScholar profiles & certs (DR-002)\nAcademic achievements (DR-003)\nClassifications & hierarchy (DR-004)\nClaims, apps, disputes (DR-005)\nInteractions (DR-006)\nSearch context (DR-007)\nCollection & sync (DR-008)\nVisibility & disclosure (DR-010)\nBackup metadata (DR-011)" as DB_MYSQL

    database "Unstructured Content Store\n(Document / Object Storage)\n\nLiterature full-text & media\nAnalysis reports (DR-009)\nMisconduct check results\nAnnotations & shared reports\nCollected raw records" as DB_UNSTR

    database "Search Index\n(Full-text / Semantic Index)\n\nMultilingual literature index\nScholar & institution index\nSemantic term mappings" as DB_SRCHIDX

    database "Cache Layer\n(Session & Query Cache)\n\nActive sessions\nSearch result cache\nPersonalization cache" as DB_CACHE
  }

  package "Acquisition & Processing" {
    node "Crawler Engine\n(External data acquisition\nFR-022,FR-023,DR-008)" as INF_CRAWLER
    node "API Gateway / Connector\n(Academic database APIs\nFR-022,DR-008)" as INF_APIGW
    node "Data Normalization & Dedup Pipeline\n(FR-023,FR-024)" as INF_NORM
  }

  package "Compute & Deployment" {
    node "Application Server Nodes\n(Linux / Windows)\nDjango WSGI/ASGI" as INF_APP
    node "Background Worker Nodes\n(Celery / async tasks)" as INF_WORKER
  }

  package "Security Infrastructure" {
    node "TLS Termination / Encrypted Transport\n(NFR-004,FR-019,C-005)" as INF_TLS
    node "Credential & Key Management\nSalted one-way password hashing\nAES-256 at-rest encryption\n(NFR-003,NFR-004)" as INF_CRYPT
  }
}

'==============================================================
' RELATIONSHIPS — Client to Application
'==============================================================
VIS -down-> BROWSER : browse / register
REG -down-> BROWSER : authenticate / search / interact
SCH -down-> BROWSER : portal / claims / messaging
IADM -down-> BROWSER : review / authorize
EXP -down-> BROWSER : dispute review
SADM -down-> BROWSER : administer / moderate

BROWSER -down-> INF_TLS : HTTPS (encrypted channel)
INF_TLS -down-> INF_APP : forward requests

'==============================================================
' Application Layer internal routing
'==============================================================
INF_APP -down-> SVC_ACCT
INF_APP -down-> SVC_LIT
INF_APP -down-> SVC_ACH
INF_APP -down-> SVC_INST
INF_APP -down-> SVC_COMM
INF_APP -down-> SVC_SYNC
INF_APP -down-> SVC_ANAL
INF_APP -down-> SVC_PROT
INF_APP -down-> SVC_ADMIN

'==============================================================
' Application Services → Support Services
'==============================================================
SVC_LIT -down-> SUP_SEM : semantic correction\n& language mapping
SVC_LIT -down-> SUP_PROF : personalization\n& diversity
SVC_LIT -down-> SUP_SRCHCTX : multi-turn context
SVC_LIT -down-> SUP_AUTH : access & disclosure check

SVC_ACCT -down-> SUP_AUTH : role & permission enforcement
SVC_ACH -down-> SUP_AUTH : visibility & ownership rules
SVC_INST -down-> SUP_AUTH : institution scope enforcement
SVC_COMM -down-> SUP_AUTH : resource & participant permissions
SVC_COMM -down-> SUP_MSG : verified private messaging
SVC_ANAL -down-> SUP_ANALENG : hotspot & influence analysis
SVC_ANAL -down-> SUP_AUTH : disclosure state enforcement
SVC_PROT -down-> SUP_AUTH : unpublished & delayed disclosure
SVC_PROT -down-> SUP_MISCON : plagiarism & blacklist check
SVC_SYNC -down-> SUP_SCHED : schedule daily sync jobs
SVC_ADMIN -down-> SUP_AUTH : administrative authorization

SUP_SCHED -down-> INF_WORKER : dispatch scheduled jobs
SUP_BKP -down-> INF_WORKER : dispatch backup jobs
SUP_SCHED .right.> SUP_BKP : trigger backup schedules

'==============================================================
' Support Services → Infrastructure Persistence
'==============================================================
SUP_AUTH -down-> DB_MYSQL : read roles, permissions,\ndisclosure states (DR-001,DR-010)
SUP_PROF -down-> DB_MYSQL : read/write profiles\n& behavior (DR-007)
SUP_SRCHCTX -down-> DB_CACHE : read/write session\nsearch context
SUP_ANALENG -down-> DB_MYSQL : read achievement & citation data
SUP_ANALENG -down-> DB_UNSTR : write analysis reports (DR-009)
SUP_MISCON -down-> DB_UNSTR : write misconduct results (DR-009)
SUP_MSG -down-> DB_MYSQL : persist conversations (DR-006)
SUP_BKP -down-> DB_MYSQL : backup structured data
SUP_BKP -down-> DB_UNSTR : backup unstructured content
SUP_BKP -down-> DB_MYSQL : write backup metadata (DR-011)

'==============================================================
' Business Services → Infrastructure Persistence
'==============================================================
SVC_ACCT -down-> DB_MYSQL : accounts, certs, profiles\n(DR-001,DR-002)
SVC_ACCT -down-> DB_CACHE : session management
SVC_LIT -down-> DB_SRCHIDX : full-text / semantic search
SVC_LIT -down-> DB_MYSQL : filtered & ranked results
SVC_LIT -down-> DB_CACHE : result caching
SVC_ACH -down-> DB_MYSQL : achievements, claims,\ndisputes (DR-003,DR-005)
SVC_ACH -down-> DB_UNSTR : achievement content refs
SVC_INST -down-> DB_MYSQL : institution hierarchy,\nmemberships (DR-004,DR-005)
SVC_COMM -down-> DB_MYSQL : comments, questions,\nfollowing, annotations (DR-006)
SVC_COMM -down-> DB_UNSTR : annotation & report content
SVC_SYNC -down-> DB_MYSQL : sync state & provenance (DR-008)
SVC_PROT -down-> DB_MYSQL : visibility, disclosure,\nauth records (DR-010)
SVC_ADMIN -down-> DB_MYSQL : review queues, decisions

'==============================================================
' Acquisition pipeline
'==============================================================
EXTAPI -down-> INF_APIGW : literature metadata\n& scholar profiles
EXTCRAWL -down-> INF_CRAWLER : scraped academic records
INF_APIGW -down-> INF_NORM : raw records\n+ source identifiers
INF_CRAWLER -down-> INF_NORM : raw records\n+ source identifiers
INF_NORM -down-> DB_MYSQL : normalized structured records\n(DR-003,DR-008)
INF_NORM -down-> DB_UNSTR : associated unstructured content
INF_NORM -down-> DB_SRCHIDX : index update
INF_WORKER -down-> SVC_SYNC : trigger incremental sync\n(FR-024)
INF_WORKER -down-> SVC_ANAL : trigger analysis run\n(FR-025)

'==============================================================
' Security infrastructure wiring
'==============================================================
INF_CRYPT -down-> DB_MYSQL : AES-256 at-rest encryption\n(NFR-004)
INF_CRYPT -down-> DB_UNSTR : AES-256 at-rest encryption
INF_CRYPT -up-> SVC_ACCT : salted password hashing\n(NFR-003)

'==============================================================
' UI to service mapping notes
'==============================================================
UI_ACCT .right.> SVC_ACCT
UI_LIT .right.> SVC_LIT
UI_ACH .right.> SVC_ACH
UI_INST .right.> SVC_INST
UI_COMM .right.> SVC_COMM
UI_ANAL .right.> SVC_ANAL
UI_ADMIN .right.> SVC_ADMIN

'==============================================================
' Legend
'==============================================================
legend right
  |= Symbol |= Meaning |
  | solid arrow | synchronous service call / data flow |
  | dashed arrow | indirect dependency / trigger |
  | FR-xxx | Functional requirement reference |
  | DR-xxx | Data requirement reference |
  | NFR-xxx | Non-functional requirement reference |
  | Layer separation follows C-004 |
endlegend

@enduml
