@startuml
title ParaStation psmpi - Documented Communication, Build and Verification Architecture (s000072_b56aad92)

skinparam componentStyle rectangle

' ============================================================
' Actors / Users
' ============================================================
actor "Developer / Tester" as Dev
actor "Integrator" as Integrator
actor "Comm-Subsystem Maintainer" as Maint

' ============================================================
' Verification and Build Environment
' ============================================================
package "Shell-Based Build & Test Environment" as BuildEnv {

  component "Embedded hwloc Verification\n(./run-embedded-tests.sh <tarball>)" as EmbeddedTest {
    note right of EmbeddedTest
      FR-001, C-002, NFR-004
      Manual only; not part of make check
    end note
  }

  component "Manual Embedded Verification\n(./autogen.sh -> ./configure -> make)" as ManualBuild {
    note right of ManualBuild
      FR-002, C-003
      Requires renamed hwloc-tree/
    end note
  }

  component "Build / Runtime Environment Variables\n(CFLAGS, LDFLAGS, LD_LIBRARY_PATH)" as EnvVars {
    note right of EnvVars
      NFR-003
    end note
  }
}

Dev --> EmbeddedTest : runs tarball verification
Dev --> ManualBuild : runs autotools sequence
Integrator --> EnvVars : supplies non-default paths

' ============================================================
' Communication Subsystem
' ============================================================
package "Communication Subsystem (Documented Design Responsibilities)" as CommSubsystem {

  component "Lifecycle & Connection Management" as Lifecycle {
    note right of Lifecycle
      FR-003, NFR-005
      Initialization, finalization,
      blocking progress, connection establishment
    end note
  }

  component "Progress Advancement" as Progress {
    note right of Progress
      FR-003
    end note
  }

  component "One-to-Many Scatter Transfer" as OneToMany {
    note right of OneToMany
      FR-004
      Scatter-style transfer
    end note
  }

  component "Send State Machine" as SendSM {
    note right of SendSM
      FR-005 .. FR-008
      Documented prototype path
    end note
  }
}

Maint --> CommSubsystem : reviews documented design

' ============================================================
' Send State Machine internals
' ============================================================
package "Send Path (send-sm)" as SendPath {

  component "Flow-Control Check\n(before posting data send)" as FlowControl {
    note right of FlowControl
      FR-005, DR-005
      Defer while flow restricted
    end note
  }

  component "Direct-Access Sending\n(pinned user data)" as DirectAccess {
    note right of DirectAccess
      FR-006, DR-002, DR-003
      short / eager / rndv-data
    end note
  }

  component "Packet-Buffer Packing\n(no direct access)" as Packing {
    note right of Packing
      FR-007, DR-003
      Pack from data descriptor
    end note
  }

  component "Rendezvous Control-Field Population" as RndvCtrl {
    note right of RndvCtrl
      FR-008, DR-004
      rndv-rts: envelope + LIBA(OD)
      rndv-cts: two LIBAs
      rndv-data: one LIBA
    end note
  }
}

SendSM --> FlowControl
SendSM --> DirectAccess
SendSM --> Packing
SendSM --> RndvCtrl

' ============================================================
' Data Objects
' ============================================================
package "Send-Path Data" as SendData {
  artifact "Packet Buffer\n(control info + optional packed payload)" as PacketBuffer
  artifact "Network Send Descriptor" as SendDesc
  artifact "Data Descriptor (DD)" as DD
  artifact "Pinned User Data" as PinnedData
  artifact "Envelope / LIBA(OD)\n(message-matching control terms)" as Envelope
}

FlowControl --> PacketBuffer : gates posting
DirectAccess --> SendDesc : binds
DirectAccess --> PinnedData : references directly
SendDesc --> PinnedData : direct access
Packing --> DD : reads payload
Packing --> PacketBuffer : writes packed payload
RndvCtrl --> PacketBuffer : writes control fields
RndvCtrl --> Envelope

' ============================================================
' Embedded Libfabric Verbs Provider
' ============================================================
package "Embedded Libfabric Module - Verbs Provider" as VerbsProvider {

  component "Verbs Provider\n(optional build integration)" as Verbs {
    note right of Verbs
      C-004
      Enabled conditionally
    end note
  }

  component "Linux Verbs API" as LinuxVerbs {
    note right of LinuxVerbs
      C-004, C-005
      libibverbs >= 1.1.8
      librdmacm >= 1.0.16
      matching headers required (NFR-001, NFR-002)
    end note
  }

  artifact "libibverbs\n(control & data transfer)" as LibIbverbs
  artifact "librdmacm\n(communication management)" as LibRdmacm
}

Integrator --> Verbs : builds / enables
Verbs --> LinuxVerbs : build integration
LinuxVerbs --> LibIbverbs
LinuxVerbs --> LibRdmacm
EnvVars ..> Verbs : non-default locations

' ============================================================
' Transport Context / Network
' ============================================================
package "CH4 Network-Module Integration Context" as CH4 {
  component "OFI / libfabric Transport" as OFI
  component "UCX Transport" as UCX
}

VerbsProvider ..> OFI : can be integrated via
CH4 --> OFI
CH4 --> UCX

component "Network Device / Send Descriptors" as NetDev
SendSM --> NetDev : interacts with
NetDev --> CH4 : transport layers

@enduml
