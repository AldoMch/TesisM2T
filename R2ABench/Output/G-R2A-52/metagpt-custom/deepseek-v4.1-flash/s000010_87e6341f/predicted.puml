@startuml

package "Client Layer" {
  component "Flutter/Dart Client\nAndroid, iOS, Web, macOS" as FlutterClient
  component "Generated Dart Client Code" as DartClientGen
}

package "API Gateway Layer" {
  component "gRPC-Gateway Middleware" as Gateway
  interface "HTTP API\naddRecipe, ListAllRecipes,\nListAllIngredientsAtHome,\nGetAllIngredientsForRecipe" as HttpApi
}

package "Service Layer" {
  component "Go gRPC Server\nRecipe and Ingredient Services" as GoServer
}

package "Contract / Code Generation Layer" {
  component "Protocol Buffers Contract\nShared .proto definitions" as ProtoContract
  interface "gRPC Service API" as GrpcApi
}

package "Generation Tooling" {
  component "protoc + Go/Dart generation plugins" as Protoc
  component "gRPC-Gateway Generation Plugins/Dependencies" as GatewayGenDeps
}

package "Deployment / Infrastructure Layer" {
  component "Docker Server Image" as DockerImage
  component "Kubernetes Deployment Configuration" as K8sConfig
  component "AKS Deployment Configuration" as AKSConfig
}

package "External Systems" {
  node "Android" as Android
  node "iOS" as iOS
  node "Web" as Web
  node "macOS" as macOS
  node "Dart toolchain + Protocol Buffers generation" as DartToolchain
  node "Go runtime + gRPC server tooling" as GoTooling
  node "gRPC-Gateway Runtime Dependencies" as GatewayRuntimeDeps
  node "Docker runtime" as DockerRuntime
  node "Kubernetes environment/local cluster" as K8sEnv
  cloud "Azure Kubernetes Service (AKS)" as AKS
  node "Standard HTTP clients (curl)" as Curl
}

FlutterClient --> DartClientGen : uses
DartClientGen --> ProtoContract : generated from
DartClientGen --> GrpcApi : generated client for
DartClientGen --> DartToolchain : generated with
DartClientGen --> Protoc : generated by

FlutterClient --> Android : runs on
FlutterClient --> iOS : runs on
FlutterClient --> Web : runs on
FlutterClient --> macOS : runs on

Gateway --> ProtoContract : generated from
Gateway --> GoServer : translates HTTP to gRPC
Gateway ..|> HttpApi : exposes
Gateway --> Protoc : generated by
Gateway --> GatewayGenDeps : generation uses
Gateway --> GatewayRuntimeDeps : runtime uses

GoServer --> ProtoContract : generated from
GoServer ..|> GrpcApi : implements
GoServer --> GoTooling : built and runs with
GoServer --> Protoc : generated by

Protoc --> ProtoContract : reads .proto

Curl --> HttpApi : HTTP requests

DockerImage --> GoServer : packages and runs
DockerImage --> DockerRuntime : requires

K8sConfig --> DockerImage : deploys
K8sConfig --> K8sEnv : deploys to

AKSConfig --> AKS : deploys to

note right of ProtoContract
  Includes message/domain contracts:
  Recipe, Ingredient, AddRecipeResponse,
  RecipeIngredientRequest, HomeIngredientRequest
  ListAllRecipes preserves server-streaming
  in gRPC and HTTP mapping (COM-004, NFR-005)
end note

note bottom of HttpApi
  HTTP mappings preserve streaming for ListAllRecipes (COM-004, NFR-005)
end note

@enduml
