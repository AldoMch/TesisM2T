{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tesis-m2t/architecture.schema.json",
  "title": "Candidate architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "requirements", "components", "connectors"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "tracesTo"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["component", "database", "external"]},
          "layer": {"type": "string", "minLength": 1},
          "tracesTo": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "type"],
        "properties": {
          "source": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "target": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "type": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

